-- Spawn a model by creating every one of its parts at the same spot:
--   for _, part in ipairs(Garrison.mods.tuareg_art_v2.models.<name>) do
--     Entity_Spawn(Entity_Create(BP_GetEntityBlueprint(part), player, position, false))
--   end

---@class Garrison.mods.tuareg_art_v2
---@field models Garrison.mods.tuareg_art_v2.models Every model in the mod by name: one blueprint per material part
---@field models_all string[][] Every model, sorted by name
---@field precache fun(player: any) Preload every model's parts for a player; call it in OnGameSetup

Garrison = Garrison or {}
Garrison.mods = Garrison.mods or {}
Garrison.mods.tuareg_art_v2 = Garrison.mods.tuareg_art_v2 or {}
local mod = Garrison.mods.tuareg_art_v2

---@class Garrison.mods.tuareg_art_v2.models
---@field tuareg_agher_shield string[] tuareg_agher_shield
---@field tuareg_leaf_spear string[] tuareg_leaf_spear
mod.models = {
	-- tuareg_agher_shield
	tuareg_agher_shield = { "c932a48123984c12a106d187971daccc:tuareg_agher_shield" },
	-- tuareg_leaf_spear
	tuareg_leaf_spear = { "c932a48123984c12a106d187971daccc:tuareg_leaf_spear" },
}

-- Every model, sorted by name.
mod.models_all = { mod.models.tuareg_agher_shield, mod.models.tuareg_leaf_spear }

-- Preload every part: an entity whose blueprint is not preloaded spawns invisible.
-- The blueprints ship in this mod's tuning pack, which the lobby selects
-- separately from the game mode.
function mod.precache(player)
	for _, parts in ipairs(mod.models_all) do
		for _, part in ipairs(parts) do
			local found, blueprint = pcall(BP_GetEntityBlueprint, part)
			if not found then
				fatal("Cannot find " .. part .. ": in the lobby, set Tuning Pack to this mod")
			end
			Entity_Precache(blueprint, 0, player, "", "DynamicPrecaching", "")
		end
	end
end
