-- Spawn a model by creating every one of its parts at the same spot:
--   for _, part in ipairs(Garrison.mods.tuareg_refined_art.models.<name>) do
--     Entity_Spawn(Entity_Create(BP_GetEntityBlueprint(part), player, position, false))
--   end

---@class Garrison.mods.tuareg_refined_art
---@field models Garrison.mods.tuareg_refined_art.models Every model in the mod by name: one blueprint per material part
---@field models_all string[][] Every model, sorted by name
---@field precache fun(player: any) Preload every model's parts for a player; call it in OnGameSetup

Garrison = Garrison or {}
Garrison.mods = Garrison.mods or {}
Garrison.mods.tuareg_refined_art = Garrison.mods.tuareg_refined_art or {}
local mod = Garrison.mods.tuareg_refined_art

---@class Garrison.mods.tuareg_refined_art.models
---@field tuareg_agher_refined string[] tuareg_agher_refined
---@field tuareg_long_spear_refined string[] tuareg_long_spear_refined
mod.models = {
	-- tuareg_agher_refined
	tuareg_agher_refined = { "31ae6f72f8b647428f42e8eabeb082ef:tuareg_agher_refined" },
	-- tuareg_long_spear_refined
	tuareg_long_spear_refined = { "31ae6f72f8b647428f42e8eabeb082ef:tuareg_long_spear_refined" },
}

-- Every model, sorted by name.
mod.models_all = { mod.models.tuareg_agher_refined, mod.models.tuareg_long_spear_refined }

-- Preload every part: an entity whose blueprint is not preloaded spawns invisible.
-- The blueprints ship in this mod's tuning pack, which the lobby selects
-- separately from the game mode.
function mod.precache(player)
	for _, parts in ipairs(mod.models_all) do
		for _, part in ipairs(parts) do
			local found, blueprint = pcall(BP_GetEntityBlueprint, part)
			if not found then
				fatal("Cannot find " .. part .. ": in the lobby, set Tuning Pack to this mod")
			end
			Entity_Precache(blueprint, 0, player, "", "DynamicPrecaching", "")
		end
	end
end
