-----------------------------------------------------------------------
-- Zenata Lancer - Blood Fury
--
-- Each attack grants +1 weapon damage for 30 seconds. Stacks are
-- unlimited and each stack expires independently.
--
-- Expiry: every stack schedules its own Rule_AddOneShot 30 seconds
-- after the attack, which removes the applied modifier handle via
-- Modifier_Remove (engine scar: "Remove an applied modifier") after
-- verifying the unit is still alive. Dead units need no removal --
-- their modifiers died with them.
-----------------------------------------------------------------------

Core_RegisterModule("ZenataLancer")

local _zenata_lancer = {
	started = false,
	stack_duration = 30.0,
	stack_damage = 1,
	blueprint_names = {
		"unit_horseman_2_mal",
		"unit_horseman_3_mal",
		"unit_horseman_4_mal",
	},
	lancer_pbgids = {},	-- [PropertyBagGroupID] = true, resolved once at start
}

-- Fast blueprint check: one Entity_GetBlueprint call and a table lookup.
-- No string round-trips (BP_GetName) on the damage hot path.
local function ZenataLancer_IsZenata(entity)
	if entity == nil or scartype(entity) ~= ST_ENTITY then
		return false
	end

	local entity_id = Entity_GetID(entity)
	if entity_id == nil or not Entity_IsValid(entity_id) then
		return false
	end

	local blueprint = Entity_GetBlueprint(entity)
	return blueprint ~= nil and _zenata_lancer.lancer_pbgids[blueprint.PropertyBagGroupID] == true
end

-- One-shot fired 30 seconds after each individual attack.
function ZenataLancer_ExpireStack(rule_id, data)
	if data == nil or data.entity_id == nil or data.applied == nil then
		return
	end

	-- Only touch the modifier if the unit still exists and is alive.
	-- If it died, the engine already discarded its modifiers.
	if not Entity_IsValid(data.entity_id) then
		return
	end

	local entity = Entity_FromID(data.entity_id)
	if entity == data.entity and Entity_IsAlive(entity) then
		Modifier_Remove(data.applied)
	end
end

function ZenataLancer_OnDamageReceived(context)
	-- Cheapest / most selective guards first: most damage events in a
	-- match are not caused by a Zenata Lancer.
	if context == nil
		or context.attacker == nil
		or context.victim == nil
		or context.attacker == context.victim
		or context.isRepairing == true
		or not ZenataLancer_IsZenata(context.attacker)
		or Entity_IsBuilding(context.victim) then
		return
	end

	-- One +1 damage stack. No cap: every hit adds another stack.
	local modifier = Modifier_Create(
		MAT_Weapon,
		"damage_weapon_modifier",
		MUT_Addition,
		false,
		_zenata_lancer.stack_damage,
		context.attacker
	)

	-- Keep the APPLIED handle returned by Modifier_ApplyToEntity;
	-- Modifier_Remove expects this handle, not the created modifier.
	local applied = Modifier_ApplyToEntity(modifier, context.attacker, 0.0)

	Rule_AddOneShot(ZenataLancer_ExpireStack, _zenata_lancer.stack_duration, {
		entity = context.attacker,
		entity_id = Entity_GetID(context.attacker),
		applied = applied,
	})
end

-- Entry point invoked from StandardMode_Start().
function Zenata_Lancer_start()
	if _zenata_lancer.started then
		return
	end

	-- Resolve custom blueprint names once; the runtime check then uses
	-- plain PBGID table lookups (no hard-coded ids, no name strings).
	for _, blueprint_name in ipairs(_zenata_lancer.blueprint_names) do
		local blueprint = BP_GetEntityBlueprint(blueprint_name)
		if blueprint ~= nil then
			_zenata_lancer.lancer_pbgids[blueprint.PropertyBagGroupID] = true
		end
	end

	_zenata_lancer.started = true
	Rule_AddGlobalEvent(ZenataLancer_OnDamageReceived, GE_DamageReceived)
end

-- Required Core module lifecycle callbacks. Startup remains controlled by
-- Zenata_Lancer_start(), which is called from StandardMode_Start().
function ZenataLancer_OnInit()
end

function ZenataLancer_Start()
end

function ZenataLancer_OnGameOver()
	if not _zenata_lancer.started then
		return
	end

	Rule_RemoveGlobalEvent(ZenataLancer_OnDamageReceived)
	Rule_Remove(ZenataLancer_ExpireStack)
	_zenata_lancer.started = false
end
