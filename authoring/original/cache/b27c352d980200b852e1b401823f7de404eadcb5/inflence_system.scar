------------------------------------------------------------------------
-- Berber Future Kingdom - Tent Influence System
--
-- Mechanic: When a unit finishes production (GE_BuildItemComplete), the
-- system finds the nearest Tent (building_hut_ayy OR spirit_way entity
-- except Funduq) within INFLUENCE_SYSTEM_RANGE world units.
-- The unit's resource cost is added to that tent's position pool.
-- When the pool reaches the required threshold, a free villager
-- (unit_villager_1_mal) is awarded. The threshold increases globally
-- per player with each reward.
--
-- Persistent State Architecture:
--   - Player tracking uses numeric integer PlayerID (from Player_GetID/player.PlayerID)
--     so state persists across event invocations (avoiding Lua table key reference mismatches).
--   - Tent tracking uses spatial position keys ("X_Z") as requested,
--     ensuring tents are uniquely identified by map coordinates.
------------------------------------------------------------------------

Core_RegisterModule("InfluenceSystem")

------------------------------------------------------------------------
-- Constants
------------------------------------------------------------------------

local INFLUENCE_SYSTEM_RANGE         = 35   -- world units, squad-to-tent proximity
local INFLUENCE_BASE_REQUIRED        = 500
local INFLUENCE_BASE_INCREASE        = 200
local INFLUENCE_FUNDUQ_BP_NAME       = "building_landmark_age1_landmarkb_mal"
local INFLUENCE_TENT_BP_NAME         = "building_hut_ayy"
local INFLUENCE_VILLAGER_BP_NAME     = "unit_villager_1_mal"

------------------------------------------------------------------------
-- Module state
------------------------------------------------------------------------

local _IS = {
    started      = false,
    player_state = {}, -- [numeric_player_id] = { reward_count, huts = { ["X_Z"] = pool } }
    villager_sbp = nil,
}

------------------------------------------------------------------------
-- Private helpers
------------------------------------------------------------------------

-- Safely converts any Player reference (Table/Userdata/ID) to a numeric PlayerID.
local function IS_GetPlayerID(player)
    if type(player) == "number" then
        return player
    end
    if type(player) == "table" then
        if player.PlayerID ~= nil then return player.PlayerID end
        if player.id ~= nil then return player.id end
    end
    if Player_GetID ~= nil then
        local ok, pid = pcall(Player_GetID, player)
        if ok and pid ~= nil then return pid end
    end
    return tostring(player)
end

-- Returns a spatial key ("X_Z") for a tent entity based on its world position.
local function IS_GetTentKey(tent_entity)
    local pos = Entity_GetPosition(tent_entity)
    return string.format("%.1f_%.1f", pos.x, pos.z)
end

local function IS_GetPlayerState(player)
    local pid = IS_GetPlayerID(player)
    local s = _IS.player_state[pid]
    if s == nil then
        s = { reward_count = 0, huts = {} }
        _IS.player_state[pid] = s
    end
    return s
end

local function IS_IsFunduq(entity)
    if entity == nil or not Entity_IsValid(Entity_GetID(entity)) then return false end
    local ebp = Entity_GetBlueprint(entity)
    return ebp ~= nil and BP_GetName(ebp) == INFLUENCE_FUNDUQ_BP_NAME
end

-- A "tent" accumulates influence. The Funduq carries spirit_way but is excluded.
local function IS_IsTent(entity)
    if entity == nil or not Entity_IsValid(Entity_GetID(entity)) then return false end
    local ebp = Entity_GetBlueprint(entity)
    if ebp == nil then return false end
    local name = BP_GetName(ebp)
    if name == INFLUENCE_TENT_BP_NAME then return true end
    if Entity_IsOfType(entity, "spirit_way") and name ~= INFLUENCE_FUNDUQ_BP_NAME then return true end
    return false
end

local function IS_PlayerHasFunduq(player)
    local pid = IS_GetPlayerID(player)
    local eg = EGroup_CreateUniqueWithPrefix("IS_Funduq")
    Player_GetEntitiesEGroup(pid, eg)
    local found = false
    for i = 1, EGroup_Count(eg) do
        if IS_IsFunduq(EGroup_GetEntityAt(eg, i)) then found = true break end
    end
    EGroup_Destroy(eg)
    return found
end

local function IS_GetRequiredValue(player, reward_count)
    local v = INFLUENCE_BASE_REQUIRED + reward_count * INFLUENCE_BASE_INCREASE
    if IS_PlayerHasFunduq(player) then
        v = v * 0.8
        print("[InfluenceSystem] Required (Funduq -20%): " .. tostring(math.floor(v)))
    else
        print("[InfluenceSystem] Required (standard): " .. tostring(math.floor(v)))
    end
    return math.floor(v)
end

local function IS_SumCost(t)
    if t == nil then return 0 end
    return (t.food or 0) + (t.wood or 0) + (t.gold or 0) + (t.stone or 0)
end

local function IS_GetVillagerSBP()
    if _IS.villager_sbp == nil then
        _IS.villager_sbp = BP_GetSquadBlueprint(INFLUENCE_VILLAGER_BP_NAME)
        if _IS.villager_sbp == nil then
            print("[InfluenceSystem] ERROR: Cannot resolve SBP '" .. INFLUENCE_VILLAGER_BP_NAME .. "'")
        end
    end
    return _IS.villager_sbp
end

-- Attempts to queue or spawn a free villager at the tent.
local function IS_TryQueueVillager(tent_entity, player)
    local pid = IS_GetPlayerID(player)
    local sbp = IS_GetVillagerSBP()
    if sbp == nil then return false end

    local ok = false
    -- Attempt 1: Try queuing into tent entity's production queue
    if Entity_HasProductionQueue(tent_entity) then
        ok = Entity_QueueProductionItemByPBG(tent_entity, PITEM_Spawn, sbp)
        if not ok then
            ok = Entity_QueueProductionItemByPBG(Entity_GetID(tent_entity), PITEM_Spawn, sbp)
        end
    end

    if ok then
        print("[InfluenceSystem] Free villager queued into Tent production queue!")
        return true
    end

    -- Attempt 2 (Fallback): Deploy free villager directly at Tent position using UnitEntry_DeploySquads
    print("[InfluenceSystem] Queue push returned false — deploying villager directly at Tent via UnitEntry_DeploySquads.")
    local tent_pos = Entity_GetPosition(tent_entity)
    local sg = SGroup_CreateUniqueWithPrefix("IS_VilSpawn")
    UnitEntry_DeploySquads(pid, sg, {{ sbp = sbp, numSquads = 1 }}, tent_pos)
    SGroup_Destroy(sg)
    return true
end

-- Find the nearest tent to a world position within INFLUENCE_SYSTEM_RANGE.
local function IS_FindNearestTent(player, position)
    local pid = IS_GetPlayerID(player)
    local eg = EGroup_CreateUniqueWithPrefix("IS_Tents")
    Player_GetEntitiesEGroup(pid, eg)

    local best_tent    = nil
    local best_dist_sq = nil
    local range_sq     = INFLUENCE_SYSTEM_RANGE * INFLUENCE_SYSTEM_RANGE

    for i = 1, EGroup_Count(eg) do
        local ent = EGroup_GetEntityAt(eg, i)
        if IS_IsTent(ent) then
            local dist_sq = World_DistanceSquaredPointToPoint(position, Entity_GetPosition(ent))
            if dist_sq <= range_sq then
                if best_dist_sq == nil or dist_sq < best_dist_sq then
                    best_tent    = ent
                    best_dist_sq = dist_sq
                end
            end
        end
    end

    EGroup_Destroy(eg)

    if best_tent ~= nil then
        local bp = Entity_GetBlueprint(best_tent)
        local key = IS_GetTentKey(best_tent)
        print("[InfluenceSystem] Nearest tent at (" .. key .. "): " .. (bp and BP_GetName(bp) or "unknown"))
    else
        print("[InfluenceSystem] No tent within " .. INFLUENCE_SYSTEM_RANGE .. " units of spawn.")
    end

    return best_tent
end

local function IS_AddValueToTent(tent_entity, player, value)
    local pid      = IS_GetPlayerID(player)
    local state    = IS_GetPlayerState(pid)
    local tent_key = IS_GetTentKey(tent_entity)
    local pool     = (state.huts[tent_key] or 0) + value
    local required = IS_GetRequiredValue(pid, state.reward_count)

    print(string.format("[InfluenceSystem] Player %s | Tent at (%s) | +%d | pool=%d / required=%d",
        tostring(pid), tent_key, value, pool, required))

    while pool >= required do
        print("[InfluenceSystem] Threshold reached — queuing/spawning free villager...")
        if not IS_TryQueueVillager(tent_entity, player) then
            print("[InfluenceSystem] Spawn failed — aborting reward loop.")
            break
        end
        pool = pool - required
        state.reward_count = state.reward_count + 1
        required = IS_GetRequiredValue(pid, state.reward_count)
        print(string.format("[InfluenceSystem] reward_count=%d | next required=%d",
            state.reward_count, required))
    end

    state.huts[tent_key] = pool
end

------------------------------------------------------------------------
-- GE_BuildItemComplete callback
-- context.player        = PLAYER
-- context.pbg           = PBG (squad blueprint)
-- context.spawnedSquad  = SQUAD (live, has position)
------------------------------------------------------------------------
function InfluenceSystem_OnBuildItemComplete(context)
    if not _IS.started then return end

    if context == nil
        or context.player == nil
        or context.pbg == nil
        or context.spawnedSquad == nil then
        return
    end

    local squad = context.spawnedSquad
    if not Squad_IsValid(Squad_GetID(squad)) then
        print("[InfluenceSystem] spawnedSquad is not valid — skipped.")
        return
    end

    local player    = context.player
    local pid       = IS_GetPlayerID(player)
    local sbp       = context.pbg
    local bp_name   = BP_GetName(sbp) or "unknown"

    print(string.format("[InfluenceSystem] GE_BuildItemComplete (Player %s): %s", tostring(pid), bp_name))

    -- Only process units with a real resource cost.
    local cost_table = Player_GetSquadBPCost(pid, sbp)
    local total_cost = IS_SumCost(cost_table)

    if total_cost <= 0 then
        print("[InfluenceSystem] Ignored '" .. bp_name .. "': zero cost.")
        return
    end

    print(string.format("[InfluenceSystem] '%s' cost: F=%s W=%s G=%s S=%s | total=%d",
        bp_name,
        tostring(cost_table and cost_table.food),
        tostring(cost_table and cost_table.wood),
        tostring(cost_table and cost_table.gold),
        tostring(cost_table and cost_table.stone),
        total_cost))

    -- Use the squad's world position to find the nearest tent.
    local spawn_pos = Squad_GetPosition(squad)
    local tent = IS_FindNearestTent(player, spawn_pos)
    if tent == nil then
        print("[InfluenceSystem] No tent near spawn — influence not recorded.")
        return
    end

    IS_AddValueToTent(tent, player, total_cost)
end

------------------------------------------------------------------------
-- Public lifecycle (called from berber_future_kingdom_GM.scar)
------------------------------------------------------------------------

function inflence_system_start()
    if _IS.started then return end

    _IS.player_state = {}
    _IS.villager_sbp = nil

    Rule_AddGlobalEvent(InfluenceSystem_OnBuildItemComplete, GE_BuildItemComplete)
    _IS.started = true
    print("[InfluenceSystem] Started — listening to GE_BuildItemComplete.")
end

function inflence_system_stop()
    if not _IS.started then return end

    Rule_RemoveGlobalEvent(InfluenceSystem_OnBuildItemComplete)
    _IS.started      = false
    _IS.player_state = {}
    _IS.villager_sbp = nil
    print("[InfluenceSystem] Stopped.")
end

------------------------------------------------------------------------
-- Core module framework callbacks
------------------------------------------------------------------------

function InfluenceSystem_OnInit()
end

function InfluenceSystem_Start()
end

function InfluenceSystem_OnGameOver()
    inflence_system_stop()
end