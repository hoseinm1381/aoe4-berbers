-- 1. Initialize the script and start listening for completed buildings
function MehariBuff_Init()
    Rule_AddGlobalEvent(OnLandmarkConstructed, GE_ConstructionComplete)
    print("Init called successfully")
end

-- 2. The event callback that checks WHICH building was constructed
function OnLandmarkConstructed(context)
    local built_entity = context.entity
    local builder_player = context.player
    
    local entity_bp = Entity_GetBlueprint(built_entity)
    
    -- Extract the actual string path of the blueprint from the game
    local built_bp_name = BP_GetName(entity_bp)
    
    -- Print exactly what the game thinks you just built
    print("Constructed building path: " .. built_bp_name)
    
    -- Check if the string matches your landmark 
    -- (Checking both with and without the ebps/ prefix just in case)
    if built_bp_name == "races/malian/buildings/landmarks/building_landmark_age1_landmarka_mal" or 
       built_bp_name == "ebps/races/malian/buildings/landmarks/building_landmark_age1_landmarka_mal" then
        
        -- Get the custom upgrade you made in the Attribute Editor
        local armor_upgrade_bp = BP_GetUpgradeBlueprint("races/malian/units/mehari/upgrade_mehari_armor_buff")
        
        -- Check if the player already has the upgrade
        if not Player_HasUpgrade(builder_player, armor_upgrade_bp) then
            -- Grant the upgrade instantly
            Player_CompleteUpgrade(builder_player, armor_upgrade_bp)
            print("EXECUTED THIS BITCH - Upgrade Applied!")
        else
            print("Player already has the upgrade.")
        end
        
    end
end