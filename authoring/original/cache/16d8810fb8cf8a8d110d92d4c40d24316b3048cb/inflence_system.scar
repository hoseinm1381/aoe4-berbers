------------------------------------------------------------------------
-- Berber Future Kingdom - Tent Influence System
--
-- ARCHITECTURE:
--   State is keyed by Player_GetID(player) — an INTEGER — so it persists
--   correctly across multiple GE_BuildItemComplete events.
--
--   Tents are tracked by POSITION KEY (rounded x_z string), not by
--   entity ID. This is safe even if the engine returns a different
--   entity object reference across calls for the same tent.
--
--   On first sight of a tent at a position, we register:
--       pos_key -> { entity_id, pool }
--   On subsequent calls, we match by pos_key to find the same record.
--
-- GE_BuildItemComplete context (confirmed in-engine):
--   context.player       = PLAYER object  (use Player_GetID for key)
--   context.pbg          = PBG (squad blueprint)
--   context.spawnedSquad = SQUAD (live, has position)
------------------------------------------------------------------------

Core_RegisterModule("InfluenceSystem")

------------------------------------------------------------------------
-- Constants
------------------------------------------------------------------------

local INFLUENCE_SYSTEM_RANGE     = 20     -- world units, squad-to-tent proximity
local INFLUENCE_BASE_REQUIRED    = 500
local INFLUENCE_BASE_INCREASE    = 200
local INFLUENCE_FUNDUQ_BP_NAME   = "building_landmark_age1_landmarkb_mal"
local INFLUENCE_TENT_BP_NAME     = "building_hut_ayy"
local INFLUENCE_VILLAGER_BP_NAME = "unit_villager_1_mal"

------------------------------------------------------------------------
-- Module state  (keyed by PLAYER INTEGER ID)
------------------------------------------------------------------------

local _IS = {
    started      = false,
    --[[
      player_state[player_int_id] = {
          reward_count  = number,
          -- tent registry: pos_key -> { entity = entity_obj, pool = number }
          tents         = {},
      }
    ]]
    player_state = {},
    villager_sbp = nil,
}

------------------------------------------------------------------------
-- Helpers
------------------------------------------------------------------------

-- Convert a world position to a stable string key (1-unit resolution).
local function IS_PosKey(pos)
    return tostring(math.floor(pos.x + 0.5)) .. "_" .. tostring(math.floor(pos.z + 0.5))
end

-- Get (or create) the state record for a player.
-- CRITICAL: always pass Player_GetID(context.player) as pid_int.
local function IS_GetPlayerState(pid_int)
    local s = _IS.player_state[pid_int]
    if s == nil then
        s = { reward_count = 0, tents = {} }
        _IS.player_state[pid_int] = s
        print("[InfluenceSystem] Created state for player " .. tostring(pid_int))
    end
    return s
end

local function IS_IsFunduq(entity)
    if entity == nil or not Entity_IsValid(Entity_GetID(entity)) then return false end
    local ebp = Entity_GetBlueprint(entity)
    return ebp ~= nil and BP_GetName(ebp) == INFLUENCE_FUNDUQ_BP_NAME
end

-- Returns true for Tents and Funduq that accumulate influence.
local function IS_IsTent(entity)
    if entity == nil or not Entity_IsValid(Entity_GetID(entity)) then return false end
    local ebp = Entity_GetBlueprint(entity)
    if ebp == nil then return false end
    local name = BP_GetName(ebp)
    if name == INFLUENCE_TENT_BP_NAME or name == INFLUENCE_FUNDUQ_BP_NAME then return true end
    if Entity_IsOfType(entity, "spirit_way") then return true end
    return false
end

local function IS_PlayerHasFunduq(player_obj)
    local eg = EGroup_CreateUniqueWithPrefix("IS_Funduq")
    Player_GetEntitiesEGroup(player_obj, eg)
    local found = false
    for i = 1, EGroup_Count(eg) do
        if IS_IsFunduq(EGroup_GetEntityAt(eg, i)) then found = true break end
    end
    EGroup_Destroy(eg)
    return found
end

local function IS_GetRequiredValue(player_obj, reward_count)
    local v = INFLUENCE_BASE_REQUIRED + reward_count * INFLUENCE_BASE_INCREASE
    if IS_PlayerHasFunduq(player_obj) then
        v = v * 0.8
        -- removed print
    else
        -- removed print
    end
    return math.floor(v)
end

local function IS_SumCost(t)
    if t == nil then return 0 end
    return (t.food or 0) + (t.wood or 0) + (t.gold or 0) + (t.stone or 0)
end

local function IS_GetVillagerSBP()
    if _IS.villager_sbp == nil then
        _IS.villager_sbp = BP_GetSquadBlueprint(INFLUENCE_VILLAGER_BP_NAME)
        if _IS.villager_sbp == nil then
            print("[InfluenceSystem] ERROR: Cannot resolve SBP '" .. INFLUENCE_VILLAGER_BP_NAME .. "'")
        end
    end
    return _IS.villager_sbp
end

-- Attempt to give one free villager at the tent.
-- Tries production-queue first; falls back to UnitEntry_DeploySquads.
local function IS_TryGiveVillager(tent_entity, player_obj)
    local sbp = IS_GetVillagerSBP()
    if sbp == nil then return false end

    -- Attempt 1: production queue push
    if Entity_HasProductionQueue(tent_entity) then
        local ok = Entity_QueueProductionItemByPBG(tent_entity, PITEM_Spawn, sbp)
        if ok then
            print("[InfluenceSystem] Villager queued via production queue.")
            return true
        end
    end

    -- Attempt 2: direct deployment at tent position
    print("[InfluenceSystem] Queue push failed — deploying directly at tent position.")
    local sg = SGroup_CreateUniqueWithPrefix("IS_VilSpawn")
    UnitEntry_DeploySquads(player_obj, sg, {{ sbp = sbp, numSquads = 1 }}, Entity_GetPosition(tent_entity))
    SGroup_Destroy(sg)
    return true
end

-- Find the nearest tent entity within INFLUENCE_SYSTEM_RANGE of spawn_pos.
-- Returns entity, or nil.
local function IS_FindNearestTentEntity(player_obj, spawn_pos)
    local eg = EGroup_CreateUniqueWithPrefix("IS_Tents")
    Player_GetEntitiesEGroup(player_obj, eg)

    local best_ent     = nil
    local best_dist_sq = nil
    local range_sq     = INFLUENCE_SYSTEM_RANGE * INFLUENCE_SYSTEM_RANGE

    for i = 1, EGroup_Count(eg) do
        local ent = EGroup_GetEntityAt(eg, i)
        if IS_IsTent(ent) then
            local d = World_DistanceSquaredPointToPoint(spawn_pos, Entity_GetPosition(ent))
            if d <= range_sq and (best_dist_sq == nil or d < best_dist_sq) then
                best_ent     = ent
                best_dist_sq = d
            end
        end
    end

    EGroup_Destroy(eg)
    return best_ent
end

------------------------------------------------------------------------
-- Core logic: add influence value to the tent nearest to the squad.
------------------------------------------------------------------------
local function IS_AddInfluence(player_obj, pid_int, spawn_pos, value)
    local state = IS_GetPlayerState(pid_int)

    -- Find nearest tent entity (live lookup each time, position is the key)
    local tent_ent = IS_FindNearestTentEntity(player_obj, spawn_pos)
    if tent_ent == nil then
        print("[InfluenceSystem] No tent within " .. INFLUENCE_SYSTEM_RANGE .. " units — ignored.")
        return
    end

    local tent_pos = Entity_GetPosition(tent_ent)
    local pos_key  = IS_PosKey(tent_pos)
    local bp_name  = BP_GetName(Entity_GetBlueprint(tent_ent)) or "unknown"

    -- Register tent on first sighting
    if state.tents[pos_key] == nil then
        state.tents[pos_key] = { entity = tent_ent, pool = 0 }
        print(string.format("[InfluenceSystem] Registered tent '%s' at key %s", bp_name, pos_key))
    else
        -- Refresh entity reference in case engine gave new object (position matched)
        state.tents[pos_key].entity = tent_ent
    end

    local record  = state.tents[pos_key]
    record.pool   = record.pool + value
    local required = IS_GetRequiredValue(player_obj, state.reward_count)

    print(string.format("[InfluenceSystem] Tent '%s' [key=%s] | +%d | pool=%d / required=%d",
        bp_name, pos_key, value, record.pool, required))

    -- Award free villagers for each threshold crossed
    while record.pool >= required do
        print("[InfluenceSystem] Threshold crossed! Giving free villager...")
        if not IS_TryGiveVillager(record.entity, player_obj) then
            print("[InfluenceSystem] Villager spawn failed — aborting.")
            break
        end
        record.pool = record.pool - required
        state.reward_count = state.reward_count + 1
        required = IS_GetRequiredValue(player_obj, state.reward_count)
        print(string.format("[InfluenceSystem] reward_count=%d | next required=%d | remaining pool=%d",
            state.reward_count, required, record.pool))
    end
end

------------------------------------------------------------------------
-- GE_BuildItemComplete callback
------------------------------------------------------------------------
function InfluenceSystem_OnBuildItemComplete(context)
    if not _IS.started then return end

    if context == nil
        or context.player == nil
        or context.pbg == nil
        or context.spawnedSquad == nil then
        return
    end

    local squad = context.spawnedSquad
    if not Squad_IsValid(Squad_GetID(squad)) then
        return
    end

    local player_obj = context.player
    local pid_int    = Player_GetID(player_obj)   -- INTEGER key, always stable
    local sbp        = context.pbg
    local bp_name    = BP_GetName(sbp) or "unknown"

    local cost_table = Player_GetSquadBPCost(player_obj, sbp)
    local total_cost = IS_SumCost(cost_table)
    if total_cost <= 0 then return end

    IS_AddInfluence(player_obj, pid_int, Squad_GetPosition(squad), total_cost)
end

------------------------------------------------------------------------
-- Public lifecycle (called from berber_future_kingdom_GM.scar)
------------------------------------------------------------------------

------------------------------------------------------------------------
-- Data Accessor for UI
------------------------------------------------------------------------
function InfluenceSystem_GetPlayerData(player_obj)
    if player_obj == nil then return nil end
    local pid_int = Player_GetID(player_obj)
    local state   = _IS.player_state[pid_int]
    
    local reward_cnt = state and state.reward_count or 0
    local req = IS_GetRequiredValue(player_obj, reward_cnt)
    local data = {
        required     = req,
        reward_count = reward_cnt,
        tents        = {}
    }
    
    if state and state.tents then
        for pos_key, tdata in pairs(state.tents) do
            if tdata.entity ~= nil and Entity_IsValid(Entity_GetID(tdata.entity)) then
                table.insert(data.tents, {
                    pos_key = pos_key,
                    entity  = tdata.entity,
                    pool    = tdata.pool or 0,
                    pos     = Entity_GetPosition(tdata.entity),
                    name    = BP_GetName(Entity_GetBlueprint(tdata.entity)) or "Tent"
                })
            end
        end
    end
    
    return data
end

function inflence_system_start()
    if _IS.started then return end
    _IS.player_state = {}
    _IS.villager_sbp = nil
    Rule_AddGlobalEvent(InfluenceSystem_OnBuildItemComplete, GE_BuildItemComplete)
    _IS.started = true
    print("[InfluenceSystem] Started — listening to GE_BuildItemComplete.")
end

function inflence_system_stop()
    if not _IS.started then return end
    Rule_RemoveGlobalEvent(InfluenceSystem_OnBuildItemComplete)
    _IS.started      = false
    _IS.player_state = {}
    _IS.villager_sbp = nil
    print("[InfluenceSystem] Stopped.")
end

------------------------------------------------------------------------
-- Core module framework callbacks
------------------------------------------------------------------------

function InfluenceSystem_OnInit()
end

function InfluenceSystem_Start()
end

function InfluenceSystem_OnGameOver()
    inflence_system_stop()
end