------------------------------------------------------------------------
-- Berber Future Kingdom - Madrasa of Fez Landmark
--
-- Triggers a one-time bonus upon completion: instantly grants Castle Age
-- upgrades, then after 1 second grants Imperial Age upgrades.
------------------------------------------------------------------------

Core_RegisterModule("MadrasaFez")

local _madrasa = {
	started = false,
	landmark_bp = nil,
	castle_upgrades = {},
	imperial_upgrades = {},
	players_applied = {}, -- Track to make it one-time per player
	pending_imperial = {},
}

local function MadrasaFez_ApplyImperialUpgrades()
	for player_id, _ in pairs(_madrasa.pending_imperial) do
		local player = Core_GetPlayersTableEntry(player_id).id
		if player ~= nil then
			for _, upg in ipairs(_madrasa.imperial_upgrades) do
				if upg ~= nil and not Player_HasUpgrade(player, upg) then
					Player_CompleteUpgrade(player, upg)
				end
			end
			print("[MadrasaFez] Applied Imperial Age upgrades for player " .. tostring(player_id))
		end
		_madrasa.pending_imperial[player_id] = nil
	end
end

function MadrasaFez_OnConstructionComplete(context)
	if not _madrasa.started then return end
	if context == nil or context.entity == nil or context.player == nil then return end

	if Entity_GetBlueprint(context.entity) == _madrasa.landmark_bp then
		local player = context.player
		local player_id = Player_GetID(player)

		if not _madrasa.players_applied[player_id] then
			_madrasa.players_applied[player_id] = true
			
			-- Apply Castle Age upgrades instantly
			for _, upg in ipairs(_madrasa.castle_upgrades) do
				if upg ~= nil and not Player_HasUpgrade(player, upg) then
					Player_CompleteUpgrade(player, upg)
				end
			end
			print("[MadrasaFez] Applied Castle Age upgrades for player " .. tostring(player_id))
			
			-- Delay Imperial Age upgrades by 1 second to ensure prerequisites are met
			_madrasa.pending_imperial[player_id] = true
			Rule_AddOneShot(MadrasaFez_ApplyImperialUpgrades, 1.0)
		end
	end
end

function madrasa_fez_start()
	if _madrasa.started then return end

	_madrasa.landmark_bp = BP_GetEntityBlueprint("building_landmark_age3_landmarke_mal")

	_madrasa.castle_upgrades = {
		BP_GetUpgradeBlueprint("upgrade_unit_archer_3_mal"),
		BP_GetUpgradeBlueprint("upgrade_unit_horseman_3_mal"),
		BP_GetUpgradeBlueprint("upgrade_unit_spearman_2_mal"),
		BP_GetUpgradeBlueprint("upgrade_unit_spearman_3_mal"),
		BP_GetUpgradeBlueprint("upgrade_unit_gbeto_3_mal"),
	}

	_madrasa.imperial_upgrades = {
		BP_GetUpgradeBlueprint("upgrade_unit_archer_4_mal"),
		BP_GetUpgradeBlueprint("upgrade_unit_horseman_4_mal"),
		BP_GetUpgradeBlueprint("upgrade_unit_spearman_4_mal"),
		BP_GetUpgradeBlueprint("upgrade_unit_knight_4"),
		BP_GetUpgradeBlueprint("upgrade_unit_gbeto_4_mal"),
	}

	Rule_AddGlobalEvent(MadrasaFez_OnConstructionComplete, GE_ConstructionComplete)
	_madrasa.started = true
	print("[MadrasaFez] Module started.")
end

function madrasa_fez_stop()
	if not _madrasa.started then return end
	Rule_RemoveGlobalEvent(MadrasaFez_OnConstructionComplete)
	_madrasa.started = false
	print("[MadrasaFez] Module stopped.")
end

function MadrasaFez_OnInit()
end

function MadrasaFez_Start()
	madrasa_fez_start()
end

function MadrasaFez_OnGameOver()
	madrasa_fez_stop()
end
